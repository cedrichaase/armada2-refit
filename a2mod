#!/usr/bin/env python3
"""Switch the whole game between stock and refit, for before/after comparisons.

    ./a2mod status        which state each layer is in
    ./a2mod stock         put every visual change aside; the game looks as shipped
    ./a2mod refit         bring them back, byte for byte
    ./a2mod stock -n      (either direction) print what would happen, touch nothing

WHY A SNAPSHOT AND NOT A REINSTALL

The obvious design -- `a2tex revert all`, then `a2tex install` and each tool's
installer -- does not reproduce what is installed.  Installed layers have lived only on
unmerged branches before (the menus layer's Embed=1 build and the condensed font both did),
and the textures depend on textures/targets/*/out, which only the main checkout has.  A reinstall from whatever
branch happens to be checked out would quietly swap in something else, and a
before/after taken across that is comparing the wrong "after".

So `stock` MOVES every modded file into $GAME/.a2mod/refit/ and puts stock back
from the backups the tools already keep; `refit` moves them back.  Same
filesystem, so these are renames: instant, and exact by construction.  The manifest
records a hash of every modded file, and `refit` checks each one on the way back.

WHAT COUNTS AS A CHANGE

    textures      Textures/RGB/*.a2neb-backup  -- a2tex
    models        SOD/*.a2neb-backup           -- logo-sod (the widened loading panel),
                                                  moon-sod, select-sod
                  Planets.asi/.ini             -- added files: planet tessellation
    lighting      Lighting.asi/.ini            -- added files: ships on the GPU, scene lights
    hud           HUD.asi/.ini                 -- added files: layout, font, cursors
                  (before hud 2.0.0: misc/*.a2neb-backup from ui-widescreen,
                  *.a2font-backup from ui-font-condense and the Curs_* art from
                  cursor-aspect -- still recognised, filed under 'hud')
    menus         Menus.asi/.ini, Menus/*.bmp  -- added files, stock has none
                  (MenuScale.* before menus 2.0.0 -- still recognised, see LEGACY_MENUS)
    msaa          MSAA.asi/.ini                -- added files
    qol           QOL.asi/.ini                 -- added files; not a look but a feel
                  (right-drag pan speed), switched so stock really is stock
    grid          GridLayout.asi/.ini          -- added files: the bar as a 5x3 grid with
                  position keys; switched so stock has stock's bar and keys
    cutscenes    binkw32.dll.a2neb-backup, binkw32_orig.dll, BinkProxy.ini, and every
                  animations/<Name>.mp4/.wav beside a <Name>.bik  -- cutscenes/binkproxy
    renderer      dxvk.conf                    -- AF, LOD bias, seamless cubes
    bloom         vkBasalt.conf enableOnLaunch -- see below

DELIBERATELY NOT SWITCHED, in both states:

    DXVK itself (d3d8.dll/d3d9.dll in the game dir) -- plumbing, not a look; stock
        wined3d is a different renderer and would make the comparison two changes.
    The ASI loader (winmm.dll) and STA2WidescreenPatch.asi -- base setup; the menu
        and MSAA hooks cannot load without the loader.
    ARMADA.PRF, RTS_CFG.h -- the player's options, set in game.  Not visual.
    The Heroic side and the vkBasalt layer itself.

BLOOM is switched with vkBasalt's own `enableOnLaunch`, not with `postfx.py --off`:
that edits Heroic's GamesConfig, which Heroic rewrites on exit, so it refuses while
Heroic is open.  enableOnLaunch=False launches with the effect bypassed.

The game must not be running.  Anything that writes the game directory while in stock
(`a2tex install`, a tool's installer) is caught on the way back: `refit` refuses
a file that is no longer stock rather than overwrite it.  Deleting $GAME/.a2mod while
in stock loses the only copy of the unmerged layers -- run `refit` first.
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

import a2env  # noqa: E402  (beside this script: where the game is)
GAME = a2env.GAME
STORE = os.path.join(GAME, '.a2mod')
SNAP = os.path.join(STORE, 'refit')
STATE = os.path.join(STORE, 'state.json')
VKCONF = os.path.join(os.environ.get('XDG_DATA_HOME', os.path.expanduser('~/.local/share')),
                      'a2-vkbasalt', 'vkBasalt.conf')

BACKUPS = ('.a2neb-backup', '.a2font-backup')
# Backups that exist but are not a visual change -- see "deliberately not switched".
EXCLUDE = {'ARMADA.PRF', 'RTS_CFG.h'}
# The menus plugin was MenuScale.asi (with .ini and a MenuScale/ plate folder) before
# menus 2.0.0.  menus/install.sh removes the old names, but a stale copy -- or one
# restored from a snapshot taken before the rename -- is still a modded file, so it
# is found and set aside like the new ones rather than left live in stock.
LEGACY_MENUS = 'MenuScale'
ADDED = [('Menus.asi', 'menus'), ('Menus.ini', 'menus'),
         ('MenuScale.asi', 'menus'), ('MenuScale.ini', 'menus'),
         ('HUD.asi', 'hud'), ('HUD.ini', 'hud'),
         ('MSAA.asi', 'msaa'), ('MSAA.ini', 'msaa'),
         ('Planets.asi', 'models'), ('Planets.ini', 'models'),
         ('QOL.asi', 'qol'), ('QOL.ini', 'qol'),
         ('QOLRules.asi', 'qol'), ('QOLRules.ini', 'qol'),
         ('GridLayout.asi', 'grid'), ('GridLayout.ini', 'grid'),
         ('Lighting.asi', 'lighting'), ('Lighting.ini', 'lighting'),
         ('binkw32_orig.dll', 'cutscenes'), ('BinkProxy.ini', 'cutscenes'),
         ('dxvk.conf', 'renderer')]
LAYERS = ['textures', 'models', 'lighting', 'hud', 'menus', 'msaa', 'qol', 'grid', 'cutscenes',
          'renderer', 'other']
# Replacement movies are whatever pairs cutscenes/binkproxy installed: <Name>.mp4 / .wav
# beside a <Name>.bik.  The .bik itself is never touched, so it is not a change.
MOVIE_DIR = 'animations'
MOVIE_EXTS = ('.mp4', '.wav')


def sha(path):
    h = hashlib.sha256()
    with open(path, 'rb') as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def layer_of(rel, suffix):
    if suffix == '.a2font-backup':
        return 'hud'
    top = rel.split('/')[0]
    # cursor-aspect.py's squashed art, from before HUD.asi (hud 2.0.0)
    if rel.lower().startswith('textures/rgb/curs_'):
        return 'hud'
    if rel.startswith('Textures/RGB/'):
        return 'textures'
    if rel == 'binkw32.dll':
        return 'cutscenes'
    if top == 'misc':
        return 'hud'
    if top == 'SOD':
        return 'models'
    return 'other'


def discover():
    """Every file this project changed, as it stands now.  Walks the backups rather
    than a list of targets, so it sees whatever any tool on any branch installed."""
    found = []
    for dirpath, dirs, files in os.walk(GAME):
        if dirpath == GAME:
            dirs[:] = [d for d in dirs if d != '.a2mod']
        for f in files:
            suffix = next((s for s in BACKUPS if f.endswith(s)), None)
            if not suffix:
                continue
            path = os.path.join(dirpath, f[:-len(suffix)])
            rel = os.path.relpath(path, GAME)
            if os.path.basename(rel) in EXCLUDE or not os.path.exists(path):
                continue
            bak = path + suffix
            # A backup beside a file still identical to it is not a change
            # (Sprites/cursor.spr: tried, reverted, backup left behind).
            if os.path.getsize(path) == os.path.getsize(bak) and sha(path) == sha(bak):
                continue
            found.append({'rel': rel, 'kind': 'replaced', 'backup': rel + suffix,
                          'layer': layer_of(rel, suffix)})
    for name, layer in ADDED:
        if os.path.exists(os.path.join(GAME, name)):
            found.append({'rel': name, 'kind': 'added', 'layer': layer})
    try:
        movies = os.listdir(os.path.join(GAME, MOVIE_DIR))
    except FileNotFoundError:
        movies = []
    biks = {os.path.splitext(f)[0].lower() for f in movies if f.lower().endswith('.bik')}
    for f in movies:
        stem, ext = os.path.splitext(f)
        if ext.lower() in MOVIE_EXTS and stem.lower() in biks:
            found.append({'rel': f'{MOVIE_DIR}/{f}', 'kind': 'added', 'layer': 'cutscenes'})
    # The menus layer's backdrop plates (menus/backdrop.sh), one per menu screen.
    for d in ('Menus', LEGACY_MENUS):
        plates = os.path.join(GAME, d)
        if os.path.isdir(plates):
            for f in sorted(os.listdir(plates)):
                if f.lower().endswith('.bmp'):
                    found.append({'rel': f'{d}/{f}', 'kind': 'added', 'layer': 'menus'})
    return sorted(found, key=lambda e: e['rel'])


def game_running():
    """Is Armada2.exe running from THIS game directory?  Any Armada2.exe used to count,
    which made the test bench's `a2mod stock` on a clone refuse whenever the real game
    was open.  A game belongs to GAME if its working directory is GAME or its
    STEAM_COMPAT_INSTALL_PATH names it (Heroic/umu set both).  A process that cannot be
    inspected still counts: refusing is the safe mistake."""
    r = subprocess.run(['pgrep', '-if', r'armada2\.exe'], capture_output=True, text=True)
    if r.returncode:
        return False
    game = os.path.realpath(GAME)
    for pid in r.stdout.split():
        try:
            if os.path.realpath(os.readlink(f'/proc/{pid}/cwd')) == game:
                return True
            with open(f'/proc/{pid}/environ', 'rb') as fh:
                env = fh.read().split(b'\0')
        except OSError:
            if os.path.exists(f'/proc/{pid}'):
                return True
            continue
        for kv in env:
            if kv.startswith(b'STEAM_COMPAT_INSTALL_PATH='):
                if os.path.realpath(kv.split(b'=', 1)[1].decode(errors='replace')) == game:
                    return True
    return False


def load_state():
    try:
        with open(STATE) as fh:
            st = json.load(fh)
    except FileNotFoundError:
        return None
    # Layer names older manifests use: 'menu scale' before menus 2.0.0; 'font',
    # 'hud layout' and (for the cursor art) 'textures' before hud 2.0.0 merged them.
    for e in st.get('entries', []):
        if e.get('layer') == 'menu scale':
            e['layer'] = 'menus'
        elif e.get('layer') in ('font', 'hud layout'):
            e['layer'] = 'hud'
        elif e.get('layer') == 'textures' and \
                e.get('rel', '').lower().startswith('textures/rgb/curs_'):
            e['layer'] = 'hud'
    return st


def save_state(st):
    os.makedirs(STORE, exist_ok=True)
    tmp = STATE + '.tmp'
    with open(tmp, 'w') as fh:
        json.dump(st, fh, indent=1)
    os.replace(tmp, STATE)


def stat_key(path):
    s = os.stat(path)
    return [s.st_size, s.st_mtime_ns]


def is_mod(path, e):
    """Current file is the recorded modded one.  A move keeps size and mtime, so that
    is the fast path; anything else is settled by hash."""
    if not os.path.exists(path):
        return False
    if stat_key(path) == e['stat']:
        return True
    return os.path.getsize(path) == e['stat'][0] and sha(path) == e['sha']


def is_stock(path, e):
    if e['kind'] == 'added':
        return not os.path.exists(path)
    if not os.path.exists(path):
        return False
    bak = os.path.join(GAME, e['backup'])
    return os.path.getsize(path) == os.path.getsize(bak) and sha(path) == sha(bak)


# --- bloom ---------------------------------------------------------------------------

def bloom_get():
    try:
        with open(VKCONF) as fh:
            for line in fh:
                k, _, v = line.partition('=')
                if k.strip() == 'enableOnLaunch':
                    return v.strip()
    except FileNotFoundError:
        return None
    return 'True'          # vkBasalt's default when the key is absent


def bloom_set(value):
    with open(VKCONF) as fh:
        lines = fh.read().splitlines()
    out, done = [], False
    for line in lines:
        if line.partition('=')[0].strip() == 'enableOnLaunch':
            line, done = f'enableOnLaunch = {value}', True
        out.append(line)
    if not done:
        out.append(f'enableOnLaunch = {value}')
    with open(VKCONF, 'w') as fh:
        fh.write('\n'.join(out) + '\n')


# --- commands --------------------------------------------------------------------------

def to_stock(dry):
    st = load_state()
    if st and st['state'] == 'stock':
        # Finish an interrupted switch, or confirm there is nothing to do.
        entries = st['entries']
        print('already stock -- checking it is complete')
    else:
        entries = discover()
        if not entries:
            sys.exit('nothing to switch -- no modded files found in the game directory')
        print(f'hashing {len(entries)} modded files ...', flush=True)
        for e in entries:
            p = os.path.join(GAME, e['rel'])
            e['sha'], e['stat'] = sha(p), stat_key(p)
        st = {'state': 'stock', 'since': time.strftime('%Y-%m-%d %H:%M:%S'),
              'entries': entries, 'bloom': bloom_get()}
    if dry:
        report(entries, 'would put aside')
        print(f'bloom: enableOnLaunch {st["bloom"]} -> False')
        return
    # State first, so an interruption leaves a record of what was in flight.
    save_state(st)
    moved = 0
    for e in entries:
        src = os.path.join(GAME, e['rel'])
        dst = os.path.join(SNAP, e['rel'])
        if not os.path.exists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            os.rename(src, dst)
            moved += 1
        if e['kind'] == 'replaced' and not is_stock(src, e):
            shutil.copy2(os.path.join(GAME, e['backup']), src)
        elif e['kind'] == 'added' and os.path.exists(src):
            sys.exit(f'{e["rel"]} reappeared in the game dir while it was set aside -- '
                     f'check it by hand')
    if st['bloom'] is not None:
        bloom_set('False')
    print(f'stock: {moved} files set aside in {SNAP}')
    status()


def to_refit(dry, force):
    st = load_state()
    if not st or st['state'] != 'stock':
        print('already refit -- nothing set aside')
        status()
        return
    entries = st['entries']
    # Pre-flight, before anything moves: every file must still be stock and every
    # snapshot must still be the file that was set aside.
    bad = []
    for e in entries:
        cur = os.path.join(GAME, e['rel'])
        snap = os.path.join(SNAP, e['rel'])
        if os.path.exists(snap):
            if not is_mod(snap, e):
                bad.append(f'{e["rel"]}: the set-aside copy has changed')
            elif not is_stock(cur, e):
                bad.append(f'{e["rel"]}: no longer stock in the game dir '
                           f'(something installed over it)')
        elif not is_mod(cur, e):
            bad.append(f'{e["rel"]}: set-aside copy missing and the game file is not it')
    if bad and not force:
        print('REFUSED -- nothing was moved:')
        for b in bad[:20]:
            print('   ', b)
        if len(bad) > 20:
            print(f'    ... and {len(bad) - 20} more')
        sys.exit('re-run with --force to let the set-aside copies win')
    if dry:
        report(entries, 'would restore')
        print(f'bloom: enableOnLaunch -> {st["bloom"]}')
        return
    for e in entries:
        snap = os.path.join(SNAP, e['rel'])
        if os.path.exists(snap):
            os.makedirs(os.path.dirname(os.path.join(GAME, e['rel'])), exist_ok=True)
            os.replace(snap, os.path.join(GAME, e['rel']))
    # Check every file on the way in by FULL hash -- not the size+mtime shortcut that
    # status uses.  This is the step that makes "byte for byte" a measurement.
    print(f'verifying {len(entries)} files by hash ...', flush=True)
    wrong = [e['rel'] for e in entries if sha(os.path.join(GAME, e['rel'])) != e['sha']]
    if wrong:
        sys.exit(f'{len(wrong)} files do not match the manifest after restore, e.g. {wrong[:5]}')
    if st['bloom'] is not None:
        bloom_set(st['bloom'])
    st['state'] = 'refit'
    st['since'] = time.strftime('%Y-%m-%d %H:%M:%S')
    save_state(st)
    for d, _, _ in sorted(os.walk(SNAP), reverse=True):
        try:
            os.rmdir(d)
        except OSError:
            pass
    print(f'refit: {len(entries)} files restored and verified against the manifest')
    if any(e['rel'].split('/')[0].startswith(LEGACY_MENUS) for e in entries):
        print(f'note: this snapshot predates the menus rename and restored {LEGACY_MENUS}.*; '
              f'run menus/install.sh to replace it with Menus.asi (a Menus.asi beside it '
              f'stands down rather than hook twice)')
    status()


def report(entries, verb):
    by = {}
    for e in entries:
        by.setdefault(e['layer'], []).append(e)
    for layer in LAYERS:
        if layer in by:
            print(f'  {verb:<16} {layer:<11} {len(by[layer]):>5} files')


def status():
    st = load_state()
    entries = st['entries'] if st else None
    if entries is None:
        # Never switched: describe what is there, all of it refit by definition.
        live = discover()
        print(f'state: refit (never switched -- no snapshot yet)')
        report(live, 'refit')
    else:
        print(f'state: {st["state"]}  (since {st["since"]})')
        by = {}
        for e in entries:
            cur = os.path.join(GAME, e['rel'])
            if st['state'] == 'stock':
                s = 'stock' if is_stock(cur, e) else 'MODIFIED'
            else:
                s = 'refit' if is_mod(cur, e) else 'CHANGED'
            by.setdefault(e['layer'], {}).setdefault(s, 0)
            by[e['layer']][s] += 1
        for layer in LAYERS:
            if layer in by:
                parts = ', '.join(f'{n} {s}' for s, n in sorted(by[layer].items()))
                print(f'  {layer:<11} {parts}')
    b = bloom_get()
    print(f'  {"bloom":<11} ' + ('vkBasalt not configured' if b is None else
                                 f'{"on" if b == "True" else "off"} at launch'))
    print(f'  {"dxvk":<11} unchanged in both states')


def main():
    args = sys.argv[1:]
    dry = '-n' in args or '--dry-run' in args
    force = '--force' in args
    cmd = next((a for a in args if not a.startswith('-')), 'status')
    if cmd in ('-h', 'help') or '-h' in args or '--help' in args:
        print(__doc__)
        return
    if not os.path.isdir(GAME):
        sys.exit(f'no game directory at {GAME} -- set A2_GAME')
    if cmd == 'status':
        status()
        return
    if cmd not in ('stock', 'refit'):
        sys.exit(f'unknown command {cmd!r} -- see ./a2mod --help')
    if game_running() and not dry:
        sys.exit('refusing: Armada2.exe is running -- quit the game first')
    if cmd == 'stock':
        to_stock(dry)
    else:
        to_refit(dry, force)


if __name__ == '__main__':
    main()
