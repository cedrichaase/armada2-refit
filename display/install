#!/usr/bin/env bash
# Install / remove Display8, the game's d3d8.dll of ours.
#
#   install             build, then put Display8 in the game's d3d8.dll slot
#   install --remove    put back the d3d8.dll that was there before
#
# What it does to the game directory (README.md, "Installing"):
#   d3d8.dll                    Display8 (ours)
#   d3d8.dll.a2display-backup   the d3d8.dll that was there before, if any: what
#                               `a2mod stock` and --remove put back in d3d8.dll
#   Display8.ini                the settings; a key the player's copy lacks is added
#
# Since display 1.0.0 nothing stands behind ours: Display8 draws on Vulkan or Direct3D
# 12, and when neither can start it hands the game the system's own d3d8.dll (README.md,
# "The bail-out"). It moves no chain behind itself any more; a d3d8_real.dll an older
# install left is not read, and retire/ (the 15.x installers) takes it out. Run it again
# to update; with Display8 already in place, only d3d8.dll is replaced.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/../a2env.sh"
GAME="$A2_GAME"
[ -d "$GAME" ] || { echo "game directory not found: $GAME" >&2; exit 1; }

ours() { [ -f "$1" ] && grep -qa "Display8 stopped the game" "$1"; }
BACKUP="$GAME/d3d8.dll.a2display-backup"

if [ "${1:-}" = "--remove" ]; then
    if ours "$GAME/d3d8.dll"; then
        rm -f "$GAME/d3d8.dll"
        # What was there before: the backup, else an older install's d3d8_real.dll that
        # retire has not taken out yet; with neither, the system's d3d8.dll is the game's.
        if [ -f "$BACKUP" ]; then
            mv "$BACKUP" "$GAME/d3d8.dll"
        elif [ -f "$GAME/d3d8_real.dll" ]; then
            mv "$GAME/d3d8_real.dll" "$GAME/d3d8.dll"
        fi
    fi
    rm -f "$BACKUP" "$GAME/d3d8_real.dll" "$GAME/Display8.ini" "$GAME/Display8.log" \
          "$GAME/Display8.inventory.tsv" "$GAME/Display8.inventory.tmp" "$GAME/Display8.mark" \
          "$GAME/Display8.go"
    echo "display: removed; d3d8.dll is the one from before Display8 again"
    exit 0
fi
[ $# -eq 0 ] || { echo "unknown argument: $1" >&2; exit 2; }

bash "$here/build.sh" >/dev/null
if [ -f "$GAME/d3d8.dll" ] && ! ours "$GAME/d3d8.dll"; then
    # A d3d8.dll that is not ours (first install, or someone put one back) is what stock
    # means from now on.
    cp -p "$GAME/d3d8.dll" "$BACKUP"
fi
cp "$here/build/d3d8.dll" "$GAME/d3d8.dll.a2display-new"
mv "$GAME/d3d8.dll.a2display-new" "$GAME/d3d8.dll"

if [ -f "$GAME/Display8.ini" ]; then
    python3 "$here/../tools/ini-merge.py" "$here/Display8.ini" "$GAME/Display8.ini"
else
    cp "$here/Display8.ini" "$GAME/Display8.ini"
fi
echo "display: Display8 $(sed -n 's/^version = "\(.*\)"/\1/p' "$here/Cargo.toml" | head -1); the bail-out is the system's d3d8.dll"
