#!/usr/bin/env bash
# Install / remove Display8, the game's d3d8.dll of ours, in forward mode.
#
#   install             build, then put Display8 in front of the game's d3d8 chain
#   install --remove    put the chain's own d3d8.dll back in its slot
#
# What it does to the game directory (README.md, "Installing"):
#   d3d8.dll                    Display8 (ours)
#   d3d8_real.dll               the d3d8.dll that was there (crosire's d3d8to9 after
#                               ./install's platform step), which ours loads and passes
#                               every call to
#   d3d8.dll.a2display-backup   the same file again: what `a2mod stock` puts back in
#                               d3d8.dll, so stock is the stock chain, not ours passing
#                               through
#   Display8.ini                the settings; a key the player's copy lacks is added
#
# A game directory with no d3d8.dll (the system's is the chain) gets ours alone: it
# loads the system's own d3d8.dll then. Run it again to update; with Display8 already
# in place, only d3d8.dll is replaced. platform/d3d8-chain.py switches the chain
# behind ours (d3d8_real.dll and the backup together).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/../a2env.sh"
GAME="$A2_GAME"
[ -d "$GAME" ] || { echo "game directory not found: $GAME" >&2; exit 1; }

ours() { [ -f "$1" ] && grep -qa "Display8 stopped the game" "$1"; }
BACKUP="$GAME/d3d8.dll.a2display-backup"

if [ "${1:-}" = "--remove" ]; then
    if ours "$GAME/d3d8.dll"; then
        rm -f "$GAME/d3d8.dll"
        if [ -f "$GAME/d3d8_real.dll" ]; then
            mv "$GAME/d3d8_real.dll" "$GAME/d3d8.dll"
        fi
    fi
    rm -f "$BACKUP" "$GAME/d3d8_real.dll" "$GAME/Display8.ini" "$GAME/Display8.log" \
          "$GAME/Display8.inventory.tsv" "$GAME/Display8.inventory.tmp" "$GAME/Display8.mark" \
          "$GAME/Display8.go"
    echo "display: removed; d3d8.dll is the chain's own again"
    exit 0
fi
[ $# -eq 0 ] || { echo "unknown argument: $1" >&2; exit 2; }

bash "$here/build.sh" >/dev/null
if [ -f "$GAME/d3d8.dll" ] && ! ours "$GAME/d3d8.dll"; then
    # A d3d8.dll that is not ours is the chain's (first install, or someone put one
    # back): it goes behind ours, and is what stock means from now on.
    cp -p "$GAME/d3d8.dll" "$GAME/d3d8_real.dll"
    cp -p "$GAME/d3d8.dll" "$BACKUP"
fi
cp "$here/build/d3d8.dll" "$GAME/d3d8.dll.a2display-new"
mv "$GAME/d3d8.dll.a2display-new" "$GAME/d3d8.dll"

if [ -f "$GAME/Display8.ini" ]; then
    python3 "$here/../ui/ini-merge.py" "$here/Display8.ini" "$GAME/Display8.ini"
else
    cp "$here/Display8.ini" "$GAME/Display8.ini"
fi
behind=$([ -f "$GAME/d3d8_real.dll" ] && echo "d3d8_real.dll" || echo "the system's d3d8.dll")
echo "display: Display8 $(sed -n 's/^version = "\(.*\)"/\1/p' "$here/Cargo.toml" | head -1) in front of $behind"
