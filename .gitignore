# This repository is published, so it holds only what may be redistributed: code,
# configuration, recipes and docs. Nothing derived from the game's own art, video or
# data -- stock copies, upscales, screenshots, footage -- is committed, whatever path it
# sits at. publish/README.md has the reasoning; publish/check.sh enforces it. Assets
# live in $A2_DATA (a2env.sh), never in a checkout.
*.tga
*.TGA
*.png
*.PNG
*.jpg
*.jpeg
*.webp
*.bmp
*.BMP
*.mp4
*.mkv
*.bik
*.wav
*.sod
*.SOD
*.spr
*.a2neb-backup

# Where assets lived before A2_DATA: a checkout from then may still have these, and
# nothing in them may be committed.
textures/.scratch/
textures/targets/*/*/
cutscenes/movies/*/*/
menus/backdrops/*/

# platform/ab-shot.sh captures
platform/ab/

__pycache__/

# a2test's input helper, built on first use from testbench/input/
testbench/input/a2input
