# This repository is published, so it holds only what may be redistributed: code,
# configuration and docs. Nothing derived from the game's own art, video or data --
# stock copies, upscales, screenshots, footage -- is committed, whatever path it sits
# at. publish/README.md has the reasoning; publish/check.sh enforces it. The texture
# work, which cannot avoid such files, is the private repository
# ~/armada2-remastered-private.
*.tga
*.TGA
*.png
*.PNG
*.jpg
*.jpeg
*.webp
*.bmp
*.BMP
*.mp4
*.mkv
*.bik
*.wav
*.sod
*.SOD
*.spr
*.a2neb-backup

# Replacement movies (cutscenes/binkproxy): only movie.conf is committed.  ai/ is PAID
# output -- never deleted or overwritten by any script; src/ and out/ are derived.
# The stock .bik stays in the game directory and is only ever read.
cutscenes/movies/*/ai/
cutscenes/movies/*/src/
cutscenes/movies/*/out/

# platform/ab-shot.sh captures
platform/ab/

__pycache__/

# a2test's input helper, built on first use from testbench/input/
testbench/input/a2input
