# Derived layers. stock/ and target.conf are the only committed parts of a target --
# except textures/targets/MBG02/src/, which is tracked ON PURPOSE: MBG02 predates the ai/ layer,
# its AI and Lanczos intermediates were scratch and are gone, and those four tiles are
# the only remaining way to reproduce the accepted candidate D byte-for-byte. Do not
# "tidy" them away; regenerating them costs ~$0.16 and a re-tune.
textures/.scratch/
textures/targets/*/out/
textures/targets/*/ai/
textures/targets/*/src/
textures/targets/*/src-alpha/
textures/targets/*/.alpha-units/

# Replacement movies (cutscenes/binkproxy): only movie.conf is committed.  ai/ is PAID
# output -- never deleted or overwritten by any script; src/ and out/ are derived.
# The stock .bik stays in the game directory and is only ever read.
cutscenes/movies/*/ai/
cutscenes/movies/*/src/
cutscenes/movies/*/out/

# selftest-mips.py imports verify.py as a module
__pycache__/
archive/ab/

# Promotional footage (promo/README.md): 447 MB of video, kept out of git
promo/*.mp4
