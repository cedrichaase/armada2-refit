#!/usr/bin/env bash
# Install the layers into the game directory ($A2_GAME, resolved by a2env.sh), each
# through its own installer, as the layer registry (layers.toml) lists them:
#
#   ./install                    every core layer (platform, display, renderer) and every
#                                selectable one that is on by default
#   ./install --only a,b         the core layers and these (with what they require)
#   ./install --without a,b      the default, less these
#   ./install --list             the layers, what each is and whether it is selected
#                                by default (tools/layers.py --list)
#   ./install --game ID ...      into another game (games/<id>.toml; default A2_PROFILE,
#                                else armada2): its folder, and only the layers its
#                                descriptor offers; a game not offered yet is refused
#
# A selectable layer a run does not select is TAKEN OUT, with its remove command, so
# `--only render3d` on an install that has the UI leaves no UI.asi behind; on a clone that
# started from stock (the test bench's --layers) that is a no-op. ./install keeps no
# memory of the selection: the next plain ./install puts everything back.
#
# The commands, in order, are each layer's `install` in layers.toml: the retired Direct3D
# chain taken out (platform/d3d8-chain.py --retire), Display8 (display/install), QOL.asi (qol/install.sh), QOLRules.asi (rules/install.sh), Online.asi
# (online/install.sh), the textures and the loading-screen model built in $A2_DATA
# (./a2tex install), the smoothed moons, asteroids, hulls and selection ring
# (models/install.sh), the cutscene proxy and its movies (cutscenes/binkproxy/install.sh),
# Render3D.asi (render3d/install.sh), and the menu backdrop plates and UI.asi
# (ui/backdrops/install-plates.sh, ui/install.sh). Before the first install it runs
# retire/retire.sh, which takes out what earlier versions put in and nothing installs any
# more: HUD.asi, GridLayout.asi, Menus.asi and MenuScale, the twelve per-part plugins, the
# file-based HUD fixes (put back to stock from their backups), the widened loading screen,
# the vkBasalt bloom and the Direct3D chain's d3d8_real.dll, d3d9.dll and dxvk.conf
# (retire/known.txt).
#
# The code layers need nothing but this checkout. The asset layers install what is
# BUILT in A2_DATA (a2env.sh; default ~/.local/share/armada2-refit): with nothing
# built -- anyone who has not made a texture pack -- each says so, installs nothing, and
# the game keeps its own art. That is a supported state, not an error.
#
# Bloom is Render3D.asi's. The per-user vkBasalt bloom that postfx/vkbasalt/build.sh put
# in before 13.0.0 (the retired vkbasalt layer) is taken out by retire.sh on every run,
# since both would bloom the frame twice; the ENABLE_VKBASALT and VKBASALT_CONFIG_FILE it
# set in Heroic do nothing without the layer. The test bench runs this into its clone of the game (a2test session start
# --install PATH [--layers a,b]).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
layers="$here/tools/layers.py"

sel=()
list=0
while [ $# -gt 0 ]; do
    case "$1" in
        --list)      list=1 ;;
        --only)      [ $# -ge 2 ] || { echo "--only needs a list of layers" >&2; exit 2; }
                     sel+=(--only "$2"); shift ;;
        --only=*)    sel+=(--only "${1#*=}") ;;
        --without)   [ $# -ge 2 ] || { echo "--without needs a list of layers" >&2; exit 2; }
                     sel+=(--without "$2"); shift ;;
        --without=*) sel+=(--without "${1#*=}") ;;
        --game)      [ $# -ge 2 ] || { echo "--game needs a game id (python3 a2env.py --list)" >&2; exit 2; }
                     export A2_PROFILE="$2"; shift ;;
        --game=*)    export A2_PROFILE="${1#*=}" ;;
        -h|--help)   sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)           echo "unknown argument: $1 (./install --help)" >&2; exit 2 ;;
    esac
    shift
done

[ "$list" = 0 ] || exec python3 "$layers" --list
# The plan first, so a refused selection touches nothing. The game is A2_PROFILE, which
# layers.py, a2env.sh and every installer read alike.
plan=$(python3 "$layers" --resolve "${sel[@]}" --commands) || exit 2

. "$here/a2env.sh"
[ -d "$A2_GAME" ] || { echo "no game directory at $A2_GAME (see a2env.sh)" >&2; exit 1; }
echo "== $(git -C "$here" describe --always --dirty 2>/dev/null || echo '?') -> $A2_GAME ($A2_PROFILE; assets: $A2_DATA)"
echo "== layers: $(python3 "$layers" --resolve "${sel[@]}" | tr '\n' ' ')"

# What earlier versions installed and nothing installs now (the legacy plugins, the
# per-part plugins, the file-based HUD fixes, the vkBasalt bloom): retire/retire.sh.
# --chain also takes out the d3d8to9 and DXVK files of the chain Display8 no longer stands
# on and a dxvk.conf we wrote (its sampler values go into Display8.ini first).
# Its tables are Armada II's: another game (Roots) has nothing of the kind to take out, and
# its d3d9.dll is a DXVK that retire.sh would recognise as the old chain's.
retire() { if [ "$A2_PROFILE" = armada2 ]; then bash "$here/retire/retire.sh" --chain "$A2_GAME"; fi; }

# Display8 is built before anything is retired: the retire step takes out the d3d8_real.dll
# an older Display8 stood in front of, so a build that failed after it would leave that
# Display8 with nothing behind it. A failed build here stops with the game as it was.
case "$plan" in
    *"display/install"*) echo "== build display"; bash "$here/display/build.sh" >/dev/null ;;
esac

retired=0
while IFS=$'\t' read -r -u 3 verb id cmd; do
    [ -n "$verb" ] || continue
    # The removes come first; the housekeeping runs once, before the first install.
    if [ "$verb" = install ] && [ "$retired" = 0 ]; then retire; retired=1; fi
    echo "== $verb $id: $cmd"
    (cd "$here" && eval "$cmd")
done 3<<<"$plan"

# A settings row that took over another file's key (moved_from) gets a player's value
# for the old key (tools/settings/README.md, "Moved keys"); nothing to do without one.
if [ "$A2_PROFILE" = armada2 ]; then python3 "$here/tools/settings/move-keys.py" "$A2_GAME"; fi
