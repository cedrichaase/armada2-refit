#!/usr/bin/env bash
# Install every layer into the game directory ($A2_GAME, resolved by a2env.sh), each
# through its own installer:
#
#   platform   platform/d3d8-chain.py --upgrade   the DXVK chain becomes the d3d8to9 one
#                                            (DXVK's d3d9 behind crosire's d3d8to9), which
#                                            lets Render3D.asi reach Direct3D 9;
#                                            any other chain is left as it is
#   menus      menus/install-plates.sh       the backdrop plates built in $A2_DATA, which the
#                                            UI's menus draw behind the main menu
#   qol        qol/install.sh                QOL.asi: right-drag pan speed
#   renderer   renderer/renderer-config.sh   dxvk.conf at stage 3, as shipped
#   textures,  ./a2tex install               every target built in $A2_DATA/textures; the
#   models                                   loading-screen model rides with LOADING
#   models     models/install.sh             the smoothed moons and asteroids, the selection
#                                            ring
#   cutscenes  cutscenes/binkproxy/install.sh  the proxy DLL, and every movie built in
#                                            $A2_DATA/movies
#   render3d   render3d/install.sh           Render3D.asi: the 3D view through render3d (HDR,
#                                            MSAA, bloom, its modules drawing every part),
#                                            and its recipes; takes out the plugins it
#                                            replaced if an earlier install left them
#   ui         ui/install.sh                 UI.asi: the HUD, the menus, the loading screen
#                                            and the cursor drawn by the UI (ui/PLAN.md);
#                                            takes out HUD.asi, GridLayout.asi and Menus.asi,
#                                            whose places its parts take (ui/supersede.sh)
#
# Not here any more: hud/install.sh, grid/install.sh and menus/install.sh. The UI
# supersedes HUD.asi, GridLayout.asi and Menus.asi (ui/README.md, "Installing"); their
# layers stay in the repository, and a player who switches a part of the UI back to
# stock can install the old plugin by hand.
#
# The code layers need nothing but this checkout. The asset layers install what is
# BUILT in A2_DATA (a2env.sh; default ~/.local/share/armada2-refit): with nothing
# built -- anyone who has not made a texture pack -- each says so, installs nothing, and
# the game keeps its own art. That is a supported state, not an error.
#
# Bloom is Render3D.asi's. The per-user vkBasalt bloom that postfx/vkbasalt/build.sh put
# in before 13.0.0 is taken out here (its layer, library and shaders, all under the
# a2-vkbasalt name), since both would bloom the frame twice; the ENABLE_VKBASALT and
# VKBASALT_CONFIG_FILE it set in Heroic do nothing without the layer. The test bench
# runs this into its clone of the game (a2test session start --install PATH).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/a2env.sh"
[ -d "$A2_GAME" ] || { echo "no game directory at $A2_GAME (see a2env.sh)" >&2; exit 1; }
echo "== $(git -C "$here" describe --always --dirty 2>/dev/null || echo '?') -> $A2_GAME (assets: $A2_DATA)"
python3 "$here/platform/d3d8-chain.py" --upgrade
"$here/menus/install-plates.sh"
"$here/qol/install.sh"
"$here/renderer/renderer-config.sh" --stage 3
share="${XDG_DATA_HOME:-$HOME/.local/share}"
old_bloom=("$share/a2-vkbasalt")
# The library and the build cache only with the layer's manifest: the bench's run has its
# own XDG_DATA_HOME, and must not reach into the real ~/.local/lib.
manifest="$share/vulkan/implicit_layer.d/vkBasalt.a2.x86.json"
[ -e "$manifest" ] && old_bloom+=("$manifest" "$HOME/.local/lib/a2-vkbasalt" \
                                  "${XDG_CACHE_HOME:-$HOME/.cache}/a2-vkbasalt")
for old in "${old_bloom[@]}"; do
    [ -e "$old" ] || continue
    rm -rf "$old"
    echo "removed the old vkBasalt bloom: $old"
done
"$here/a2tex" install
"$here/models/install.sh"
"$here/cutscenes/binkproxy/install.sh"
"$here/render3d/install.sh"
"$here/ui/install.sh"
