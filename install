#!/usr/bin/env bash
# Install the layers into the game directory ($A2_GAME, resolved by a2env.sh), each
# through its own installer, as the layer registry (layers.toml) lists them:
#
#   ./install                    every core layer (platform, display, renderer) and every
#                                selectable one that is on by default
#   ./install --only a,b         the core layers and these (with what they require)
#   ./install --without a,b      the default, less these
#   ./install --list             the layers, what each is and whether it is selected
#                                by default (tools/layers.py --list)
#
# A selectable layer a run does not select is TAKEN OUT, with its remove command, so
# `--only render3d` on an install that has the UI leaves no UI.asi behind; on a clone that
# started from stock (the test bench's --layers) that is a no-op. ./install keeps no
# memory of the selection: the next plain ./install puts everything back. Until the rules
# layer has its own installer it shares qol's, so --without rules leaves QOLRules.asi in
# while qol is in.
#
# The commands, in order, are each layer's `install` in layers.toml: the Direct3D chain
# (platform/d3d8-chain.py --upgrade), Display8 (display/install), dxvk.conf
# (renderer/renderer-config.sh), QOL.asi and QOLRules.asi (qol/install.sh), Online.asi
# (online/install.sh), the textures and the loading-screen model built in $A2_DATA
# (./a2tex install), the smoothed moons, asteroids, hulls and selection ring
# (models/install.sh), the cutscene proxy and its movies (cutscenes/binkproxy/install.sh),
# Render3D.asi (render3d/install.sh, which also takes out the per-part plugins it
# replaced), and the menu backdrop plates and UI.asi (menus/install-plates.sh,
# ui/install.sh, which takes out HUD.asi, GridLayout.asi and Menus.asi: ui/supersede.sh).
# HUD.asi, GridLayout.asi and Menus.asi are `legacy` layers: only the release's fallback
# without Direct3D 9 installs them, and a player who switches a part of the UI back to
# stock can install the old plugin by hand.
#
# The code layers need nothing but this checkout. The asset layers install what is
# BUILT in A2_DATA (a2env.sh; default ~/.local/share/armada2-refit): with nothing
# built -- anyone who has not made a texture pack -- each says so, installs nothing, and
# the game keeps its own art. That is a supported state, not an error.
#
# Bloom is Render3D.asi's. The per-user vkBasalt bloom that postfx/vkbasalt/build.sh put
# in before 13.0.0 (the retired vkbasalt layer) is taken out here on every run (its layer,
# library and shaders, all under the a2-vkbasalt name), since both would bloom the frame
# twice; the ENABLE_VKBASALT and VKBASALT_CONFIG_FILE it set in Heroic do nothing without
# the layer. The test bench runs this into its clone of the game (a2test session start
# --install PATH [--layers a,b]).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
layers="$here/tools/layers.py"

sel=()
while [ $# -gt 0 ]; do
    case "$1" in
        --list)      exec python3 "$layers" --list ;;
        --only)      [ $# -ge 2 ] || { echo "--only needs a list of layers" >&2; exit 2; }
                     sel+=(--only "$2"); shift ;;
        --only=*)    sel+=(--only "${1#*=}") ;;
        --without)   [ $# -ge 2 ] || { echo "--without needs a list of layers" >&2; exit 2; }
                     sel+=(--without "$2"); shift ;;
        --without=*) sel+=(--without "${1#*=}") ;;
        -h|--help)   sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)           echo "unknown argument: $1 (./install --help)" >&2; exit 2 ;;
    esac
    shift
done

# The plan first, so a refused selection touches nothing.
plan=$(python3 "$layers" --resolve "${sel[@]}" --commands) || exit 2

. "$here/a2env.sh"
[ -d "$A2_GAME" ] || { echo "no game directory at $A2_GAME (see a2env.sh)" >&2; exit 1; }
echo "== $(git -C "$here" describe --always --dirty 2>/dev/null || echo '?') -> $A2_GAME (assets: $A2_DATA)"
echo "== layers: $(python3 "$layers" --resolve "${sel[@]}" | tr '\n' ' ')"

# The retired vkBasalt bloom, outside the game directory.
retire() {
    local share="${XDG_DATA_HOME:-$HOME/.local/share}"
    local old_bloom=("$share/a2-vkbasalt")
    # The library and the build cache only with the layer's manifest: the bench's run has its
    # own XDG_DATA_HOME, and must not reach into the real ~/.local/lib.
    local manifest="$share/vulkan/implicit_layer.d/vkBasalt.a2.x86.json"
    [ -e "$manifest" ] && old_bloom+=("$manifest" "$HOME/.local/lib/a2-vkbasalt" \
                                      "${XDG_CACHE_HOME:-$HOME/.cache}/a2-vkbasalt")
    local old
    for old in "${old_bloom[@]}"; do
        [ -e "$old" ] || continue
        rm -rf "$old"
        echo "removed the old vkBasalt bloom: $old"
    done
    # Retired from the game directory: A2EngineTest.ini, the bench's fault injection
    # (crates/a2engine/README.md, "The test mismatch file"), which no install ships.
    for old in "$A2_GAME/A2EngineTest.ini"; do
        [ -e "$old" ] || continue
        rm -f "$old"
        echo "removed $old (a test bench file)"
    done
}

retired=0
while IFS=$'\t' read -r -u 3 verb id cmd; do
    [ -n "$verb" ] || continue
    # The removes come first; the housekeeping runs once, before the first install.
    if [ "$verb" = install ] && [ "$retired" = 0 ]; then retire; retired=1; fi
    echo "== $verb $id: $cmd"
    (cd "$here" && eval "$cmd")
done 3<<<"$plan"
