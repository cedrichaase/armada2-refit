#!/usr/bin/env bash
# Put Scene.asi into a test-bench clone:
#   ./a2test session start --install . --install testbench/scene --args '-nointro a2_borg01'
#   SCENE=planet ./a2test session start ...      # testbench/scene/scenes/planet.ini
#   SCENE_INI=my.ini ./a2test session start ...  # a scene file of your own
# Refuses any game directory that is not an a2test clone: the scene builder is a
# test tool and never goes into the player's install.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/../../a2env.sh"
GAME="$A2_GAME"

case "$GAME" in
    "$HOME"/.cache/a2test/*) ;;
    *) echo "refusing: $GAME is not an a2test clone" >&2; exit 1 ;;
esac

ini="$here/Scene.ini"
if [ -n "${SCENE:-}" ]; then ini="$here/scenes/$SCENE.ini"; fi
if [ -n "${SCENE_INI:-}" ]; then ini="$SCENE_INI"; fi
if [ ! -f "$ini" ]; then echo "no scene file $ini" >&2; exit 1; fi

bash "$here/build.sh"
cp "$here/build/Scene.asi" "$GAME/"
cp "$ini" "$GAME/Scene.ini"
# SCENE_MUSIC=0 puts Music=0 into the installed copy (the scene file itself stays as it is)
if [ "${SCENE_MUSIC:-1}" = 0 ]; then sed -i 's/^\[Scene\]\r\?$/&\nMusic=0/' "$GAME/Scene.ini"; fi
# SCENE_RACE=<race> puts Race=<race> into it the same way, ahead of any Race= of the file's own
if [ -n "${SCENE_RACE:-}" ]; then sed -i "s/^\[Scene\]\r\?\$/&\nRace=$SCENE_RACE/" "$GAME/Scene.ini"; fi
# SCENE_SEED=<n>, SCENE_PAUSE=<tick> and SCENE_STEP=<ms> likewise put Seed=, Pause= and Step= into it, for a
# frame that repeats from launch to launch (README.md, "A frame that repeats")
if [ -n "${SCENE_SEED:-}" ]; then sed -i "s/^\[Scene\]\r\?\$/&\nSeed=$SCENE_SEED/" "$GAME/Scene.ini"; fi
if [ -n "${SCENE_PAUSE:-}" ]; then sed -i "s/^\[Scene\]\r\?\$/&\nPause=$SCENE_PAUSE/" "$GAME/Scene.ini"; fi
if [ -n "${SCENE_STEP:-}" ]; then sed -i "s/^\[Scene\]\r\?\$/&\nStep=$SCENE_STEP/" "$GAME/Scene.ini"; fi
rm -f "$GAME/Scene.log" "$GAME/Scene.cmd"
echo "installed Scene.asi into $GAME, scene $ini"
